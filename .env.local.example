# URL do projeto (Settings → API → Project URL)
# Use APENAS a URL base — SEM /rest/v1/ no final
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# Chave anon public (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# URL pública do app (necessária para OAuth Gmail)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Service Role Key do Supabase (Settings → API → service_role)
# Necessária APENAS para a gestão de contas (/api/accounts/*)
# NUNCA exponha esta chave no frontend — use apenas server-side
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Credenciais OAuth2 do Google (console.cloud.google.com)
# Necessárias apenas para a integração Gmail
GOOGLE_CLIENT_ID=seu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui